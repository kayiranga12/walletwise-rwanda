rules_version = '2';

// Every WalletWise document carries the owner's uid in `user_id`.
// Deploy with: firebase deploy --only firestore:rules
// (or paste into Firebase console > Firestore Database > Rules)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function ownsExisting() {
      return resource.data.user_id == request.auth.uid;
    }
    function ownsIncoming() {
      return request.resource.data.user_id == request.auth.uid;
    }

    match /{collection}/{docId} {
      allow read: if signedIn() && ownsExisting();
      allow create: if signedIn() && ownsIncoming();
      allow update: if signedIn() && ownsExisting() && ownsIncoming();
      // Deleting something already gone must succeed, or the queue retries forever
      allow delete: if signedIn() && (resource == null || ownsExisting());
    }

    // Goal transactions uploaded by older versions had no owner; let the
    // app attach the uid to its own goal's transactions once.
    match /transactions/{docId} {
      allow update: if signedIn() && !('user_id' in resource.data)
        && ownsIncoming()
        && get(/databases/$(database)/documents/savings_goals/$(resource.data.goal_id)).data.user_id == request.auth.uid;
    }
  }
}
